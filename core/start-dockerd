#!/bin/sh
# Start dockerd in the background and wait until it answers.
# START_DOCKERD_TIMEOUT: seconds to wait (default 30).
set -eu

if [ "$(id -u)" != 0 ]; then
	exec sudo START_DOCKERD_TIMEOUT="${START_DOCKERD_TIMEOUT:-30}" "$0" "$@"
fi

docker info >/dev/null 2>&1 && exit 0

# Adopt a daemon that is already starting instead of launching a second one.
pid=$(pgrep -x dockerd | head -n 1 || true)
started=
if [ -z "$pid" ]; then
	dockerd >>/var/log/dockerd.log 2>&1 &
	pid=$!
	started=1
fi

timeout=${START_DOCKERD_TIMEOUT:-30}
while ! docker info >/dev/null 2>&1; do
	if ! kill -0 "$pid" 2>/dev/null; then
		tail -n 20 /var/log/dockerd.log >&2
		exit 1
	fi
	if [ "$timeout" -le 0 ]; then
		[ -n "$started" ] && kill "$pid" 2>/dev/null || true
		tail -n 20 /var/log/dockerd.log >&2
		exit 1
	fi
	timeout=$((timeout - 1))
	sleep 1
done
