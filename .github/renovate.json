{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions"
  ],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv version from GitHub releases, which have publish dates; GHCR has none",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["COPY --from=ghcr\\.io/astral-sh/uv:(?<currentValue>[^@\\s]+)@"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchNewValue": "/\\.0$/",
      "minimumReleaseAge": "10 days"
    },
    {
      "matchDepNames": ["ubuntu"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "uv versions come from the GitHub releases manager above",
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/astral-sh/uv"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": "After a uv version bump, repin the image digest to the new tag; the version already waited",
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/astral-sh/uv"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
