// Do not add the docker-in-docker Feature: the image runs its own Docker engine under systemd.
{
	"name": "images",
	"image": "ghcr.io/plume-works/devcontainer-base:edge@sha256:283df43f0be62d88ea4995a828b3842b7c89b80c8927a08f3c20a5be4e9fe93e",
	"privileged": true,
	"mounts": [
		"source=dc-${devcontainerId}-docker,target=/var/lib/docker,type=volume",
		"source=dc-${devcontainerId}-containerd,target=/var/lib/containerd,type=volume",
		"source=dc-${devcontainerId}-home,target=/home/dev,type=volume"
	],

	// The image's metadata already sets the remote user (dev) and installs the Claude Code extension.
	"customizations": {
		"vscode": {
			"extensions": [
				"mhutchie.git-graph",
				"eamodio.gitlens",
				"codezombiech.gitignore"
			]
		}
	}
}
