# Claude pre-approval (ADR 0003), under agent-services.target: once per start of the target, before remote
# control, from the Coder template's choices in the imported environment (ADR 0002). See the script for what
# it writes. Not run from remote control's own unit, which is restarted every 15 seconds until a sign-in exists.
[Unit]
Description=Claude pre-approval (the Coder template's choices)
PartOf=agent-services.target
Before=claude-remote-control.service

[Service]
Type=oneshot
# Active until the target stops, so it runs again only at its next start.
RemainAfterExit=yes
ExecStart=/usr/local/bin/claude-pre-approval
