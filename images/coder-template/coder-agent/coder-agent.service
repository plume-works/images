# The Coder template uploads /etc/coder/agent-init.sh and /etc/coder/agent-token before the container starts.
[Unit]
Description=Coder agent
Wants=network-online.target user@1000.service
After=network-online.target user@1000.service
ConditionPathExists=/etc/coder/agent-init.sh

[Service]
Type=exec
User=dev
# What the agent launches (its startup script, terminals, apps) reaches dev's systemd user manager with
# `systemctl --user`: that talks to $XDG_RUNTIME_DIR/systemd/private.
Environment=XDG_RUNTIME_DIR=/run/user/1000
# The agent reads its token from this file (CODER_AGENT_TOKEN_FILE), so it never sits in the unit or in
# `docker inspect`.
Environment=CODER_AGENT_TOKEN_FILE=/etc/coder/agent-token
ExecStart=/bin/sh /etc/coder/agent-init.sh
Restart=always
RestartSec=10
TimeoutStopSec=90
# Restarting the agent leaves the shells and sessions it started running.
KillMode=process
OOMScoreAdjust=-900
SyslogIdentifier=coder-agent

[Install]
WantedBy=multi-user.target
