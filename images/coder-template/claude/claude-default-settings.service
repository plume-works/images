[Unit]
Description=Claude default settings (written over the user's at each start)
PartOf=agent-services.target
# Claude pre-approval adds to the same file, and remote control must start with the defaults in place.
Before=claude-pre-approval.service claude-remote-control.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/mkdir -p %h/.claude
# Writes the link's target, so that a symlinked file (a dotfiles checkout's, say) stays a link; resolved first,
# because cp refuses to write through a link whose target does not exist yet.
ExecStart=/bin/sh -c 'exec cp /usr/local/share/claude-code/default-settings.json "$$(readlink -f %h/.claude/settings.json)"'
