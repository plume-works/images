#!/usr/bin/env python3
# enabledPlugins in a repository's .claude/settings.json does not install a plugin, and no session here answers
# the prompt that would. It runs at each start: the Claude default settings then replace the user settings, which
# drops what an install declares there, though the installed plugins stay on disk.
import json
import os
import subprocess
import sys
from pathlib import Path

# Only an interactive session adds Claude Code's own marketplace, and a repository need not declare it.
OFFICIAL = 'claude-plugins-official'
OFFICIAL_SOURCE = 'anthropics/claude-plugins-official'

LOCATION_FIELD = {'directory': 'path', 'file': 'path', 'url': 'url', 'github': 'repo', 'git': 'url'}


def marketplace_source(source: object) -> str:
    """The argument `claude plugin marketplace add` takes; ValueError says why there is none."""
    if not isinstance(source, dict):
        raise ValueError('it has no source')
    kind = source.get('source')
    field = LOCATION_FIELD.get(kind) if isinstance(kind, str) else None
    if field is None:
        raise ValueError(f'its kind of source, {kind!r}, is not supported here')
    location = source.get(field)
    if not isinstance(location, str) or not location:
        raise ValueError(f'its {kind} source has no {field}')
    ref = source.get('ref') if kind in ('github', 'git') else None
    if ref is not None and not isinstance(ref, str):
        raise ValueError(f'its {kind} source has a ref that is not a string')
    return f'{location}#{ref}' if ref else location


def error(message: str) -> None:
    # Printed at once, not at the end: the unit's start timeout kills the script mid-run.
    print(f'error: could not {message}', file=sys.stderr, flush=True)


def main() -> int:
    if os.environ.get('CLAUDE_INSTALL_REPO_PLUGINS', 'false') != 'true':
        return 0
    repo = os.environ.get('REPO_DIR')
    if not repo:
        error('find the repository: REPO_DIR is not set, and the Coder startup script imports it')
        return 1
    settings_file = Path(repo, '.claude', 'settings.json')
    if not settings_file.is_file():
        return 0
    try:
        settings = json.loads(settings_file.read_text())
    except (OSError, ValueError) as e:
        error(f'read {settings_file}: {e}')
        return 1
    if not isinstance(settings, dict):
        error(f'read {settings_file}: it is not a JSON object')
        return 1

    failed = False

    def section(key: str) -> dict:
        nonlocal failed
        value = settings.get(key) or {}
        if isinstance(value, dict):
            return value
        error(f'read {key} in {settings_file}: it is not a JSON object')
        failed = True
        return {}

    def claude_plugin(*args: str, what: str) -> None:
        nonlocal failed
        try:
            # A directory marketplace's path is relative to the repository.
            ok = subprocess.run(['claude', 'plugin', *args], cwd=repo).returncode == 0
        except OSError as e:
            error(f'{what}: {e}')
            failed = True
            return
        if not ok:
            error(what)
            failed = True

    enabled = [plugin for plugin, on in section('enabledPlugins').items() if on is True]
    for name, entry in section('extraKnownMarketplaces').items():
        try:
            source = marketplace_source(entry.get('source') if isinstance(entry, dict) else None)
        except ValueError as e:
            error(f'add the marketplace {name}: {e}')
            failed = True
            continue
        claude_plugin('marketplace', 'add', source, what=f'add the marketplace {name}')
    if any(plugin.endswith(f'@{OFFICIAL}') for plugin in enabled):
        claude_plugin('marketplace', 'add', OFFICIAL_SOURCE, what=f'add the marketplace {OFFICIAL}')
    for plugin in enabled:
        claude_plugin('install', plugin, '--scope', 'user', what=f'install the plugin {plugin}')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
