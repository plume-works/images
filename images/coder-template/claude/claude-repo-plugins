#!/usr/bin/env python3
# enabledPlugins in a repository's .claude/settings.json does not install a plugin, and no session here answers
# the prompt that would. It runs at each start: the Claude default settings then replace the user settings, which
# drops what an install declares there, though the installed plugins stay on disk.
import json
import os
import subprocess
import sys
from functools import partial
from pathlib import Path

# Only an interactive session adds Claude Code's own marketplace, and a repository need not declare it.
OFFICIAL = 'claude-plugins-official'
OFFICIAL_SOURCE = 'anthropics/claude-plugins-official'

LOCATION_FIELD = {'github': 'repo', 'git': 'url', 'url': 'url'}


def claude_plugin(*args: str) -> None:
    subprocess.run(['claude', 'plugin', *args], check=True)


def add_marketplace(entry: dict, repo: Path) -> None:
    source = entry['source']
    kind = source['source']
    if kind in ('directory', 'file'):
        # The command takes a path only when it starts with ./, ../, / or ~ (tools/market would be that GitHub
        # repository), and the settings' path is relative to the repository.
        location = str(repo / Path(source['path']).expanduser())
    else:
        location = source[LOCATION_FIELD[kind]]
        if ref := source.get('ref'):
            location += f'#{ref}'
    claude_plugin('marketplace', 'add', location)


def steps(repo: Path) -> list:
    settings_file = repo / '.claude' / 'settings.json'
    settings = json.loads(settings_file.read_text()) if settings_file.is_file() else {}
    enabled = [plugin for plugin, on in settings.get('enabledPlugins', {}).items() if on is True]
    todo = [
        (f'add the marketplace {name}', partial(add_marketplace, entry, repo))
        for name, entry in settings.get('extraKnownMarketplaces', {}).items()
    ]
    if any(plugin.endswith(f'@{OFFICIAL}') for plugin in enabled):
        todo.append((f'add the marketplace {OFFICIAL}', partial(claude_plugin, 'marketplace', 'add', OFFICIAL_SOURCE)))
    todo += [
        (f'install the plugin {plugin}', partial(claude_plugin, 'install', plugin, '--scope', 'user'))
        for plugin in enabled
    ]
    return todo


def report(what: str, e: Exception) -> None:
    # Printed at once, not at the end: the unit's start timeout kills the script mid-run.
    print(f'error: could not {what}: {type(e).__name__}: {e}', file=sys.stderr, flush=True)


def main() -> int:
    if os.environ.get('CLAUDE_INSTALL_REPO_PLUGINS') != 'true':
        return 0
    try:
        todo = steps(Path(os.environ['REPO_DIR']))
    except Exception as e:
        report("read the repository's Claude settings", e)
        return 1
    failed = False
    # One catch-all per step, so that a bad entry or a failed install leaves the rest to run.
    for what, step in todo:
        try:
            step()
        except Exception as e:
            report(what, e)
            failed = True
    return int(failed)


if __name__ == '__main__':
    sys.exit(main())
