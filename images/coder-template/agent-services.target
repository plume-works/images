# The services that need the Coder agent's environment (user secrets included). Nothing starts this target at
# boot: the Coder template's startup script starts it, after handing its environment to this user manager
# (ADR 0002):
#   systemctl --user import-environment $(compgen -e)
#   systemctl --user start agent-services.target
[Unit]
Description=Agent services (started by the Coder agent, never at boot)
Wants=opencode.service claude-remote-control.service claude-bridge-prompt-scrub.service
