#!/bin/sh
# Claude pre-approval (ADR 0003), run by claude-pre-approval.service as the workspace user. Records in the user's
# ~/.claude.json what the user would otherwise answer at Claude's first-run prompts, merging into what is there.
# The Coder template's two choices arrive as imported variables (ADR 0002), each `true` or `false`; unset means
# off. Off means not written: nothing is ever revoked.
#   always                                    onboarding completed
#   CLAUDE_PREAPPROVE_REMOTE_CONTROL=true     remote control consent
#   CLAUDE_PREAPPROVE_TRUST_WORKSPACE=true    trust in REPO_DIR, and in its project MCP servers (Claude Code moves
#                                             that approval into REPO_DIR's .claude/settings.local.json at start)
set -eu
# ~/.claude.json holds the sign-in: whatever is written here is for the user only.
umask 077

remote_control=${CLAUDE_PREAPPROVE_REMOTE_CONTROL:-false}
trust=${CLAUDE_PREAPPROVE_TRUST_WORKSPACE:-false}

file=~/.claude.json
[ -s "$file" ] || echo '{}' >"$file"
# shellcheck disable=SC2016 # jq's own $variables
jq --argjson rc "$remote_control" --argjson trust "$trust" --arg dir "${REPO_DIR:?not set: the Coder startup script imports it}" '
  .hasCompletedOnboarding = true
  | if $rc then .remoteDialogSeen = true end
  | if $trust then .projects[$dir] += {hasTrustDialogAccepted: true, enableAllProjectMcpServers: true} end' \
  "$file" >"$file.new"
mv "$file.new" "$file"
