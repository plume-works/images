#!/bin/sh
# enabledPlugins in a repository's .claude/settings.json does not install a plugin, and no session here answers
# the prompt that would. It runs at each start: the Claude default settings then replace the user settings, which
# drops what an install declares there, though the installed plugins stay on disk.
set -eu
[ "${CLAUDE_INSTALL_REPO_PLUGINS:-false}" = true ] || exit 0
cd "${REPO_DIR:?not set: the Coder startup script imports it}"
settings=.claude/settings.json
[ -f "$settings" ] || exit 0

failed=0
warn() {
  echo "warning: could not $1" >&2
  failed=1
}

# The repository's own marketplaces are used only through a trust prompt, so each is added here.
# A source of another kind is left out: the install of its plugins then warns.
for source in $(jq -r '.extraKnownMarketplaces // {} | to_entries[] | .value.source
  | if .source == "github" then .repo elif .source == "git" or .source == "url" then .url
    elif .source == "directory" or .source == "file" then .path else empty end' "$settings"); do
  claude plugin marketplace add "$source" || warn "add the marketplace $source"
done
# Only an interactive session adds Claude Code's own marketplace, and a repository need not declare it.
if jq -e '.enabledPlugins // {} | keys | any(endswith("@claude-plugins-official"))' "$settings" >/dev/null; then
  claude plugin marketplace add anthropics/claude-plugins-official || warn "add Claude Code's own marketplace"
fi

for plugin in $(jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' "$settings"); do
  claude plugin install "$plugin" --scope user || warn "install the plugin $plugin"
done
exit "$failed"
