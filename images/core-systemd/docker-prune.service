# Each setting is an age or `off`; override any of them with a drop-in in docker-prune.service.d/.
# Named volumes are kept by default: one may sit unattached on purpose, holding a login or a cache.
[Unit]
Description=Remove stopped containers, unused volumes, images and build cache older than their ages
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=PRUNE_STOPPED_CONTAINERS=168h
Environment=PRUNE_ANONYMOUS_VOLUMES=168h
Environment=PRUNE_NAMED_VOLUMES=off
Environment=PRUNE_IMAGES=168h
Environment=PRUNE_BUILD_CACHE=168h
ExecStart=/usr/local/bin/docker-prune
