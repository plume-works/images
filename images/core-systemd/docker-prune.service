# Run weekly by docker-prune.timer.
# `image prune --all` removes only images no container (running or stopped) uses. Under the containerd
# image store its `until` filter is when the image was pulled or built here: Docker records no last-use time
# for images, so an image whose last container was removed (say, run with --rm) goes once it is over a week
# old, and the next run pulls it again.
# `builder prune` keeps build cache used within the window (no --all: that also clears helper images).
# Never prune volumes or containers: they are the user's work.
[Unit]
Description=Remove unused Docker images older than a week, and build cache unused for a week
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=UNUSED_FOR=168h
ExecStart=/usr/bin/docker image prune --all --force --filter until=${UNUSED_FOR}
ExecStart=/usr/bin/docker builder prune --force --filter until=${UNUSED_FOR}
