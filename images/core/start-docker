#!/bin/sh
# start-docker: make sure a Docker engine is running, and return once it answers.
#
# For containers that do not run systemd (a CI job container): needs --privileged
# (or sysbox) and a volume at /var/lib/docker. Does nothing if an engine already
# answers. Where systemd is PID 1 it only asks systemd to start docker.service.
# Run as root or as a user with passwordless sudo. START_DOCKER_TIMEOUT (seconds,
# default 60) bounds the wait; the engine logs to /var/log/dockerd.log.
set -eu
timeout="${START_DOCKER_TIMEOUT:-60}"
log=/var/log/dockerd.log

if [ "$(id -u)" != 0 ]; then
  exec sudo -n --preserve-env=START_DOCKER_TIMEOUT "$0" "$@"
fi

docker info >/dev/null 2>&1 && exit 0

if [ -d /run/systemd/system ]; then
  # systemd is PID 1: it owns the engine.
  systemctl start docker.service
else
  # Serialize concurrent first calls so only one of them launches dockerd.
  exec 9>/run/start-docker.lock
  flock 9
  if ! { [ -s /run/docker.pid ] && kill -0 "$(cat /run/docker.pid)" 2>/dev/null; }; then
    mkdir -p /var/lib/docker
    if [ "$(stat -f -c %T /var/lib/docker)" = overlayfs ]; then
      echo "start-docker: /var/lib/docker is on the container's overlay filesystem, where the engine" >&2
      echo "cannot start containers. Run this container with --volume /var/lib/docker" >&2
      echo "(GitHub Actions: container.options: --privileged --volume /var/lib/docker)." >&2
      exit 1
    fi
    # cgroup v2: move this namespace's processes out of its root cgroup so dockerd
    # can enable every controller for its containers (as moby's hack/dind does).
    if [ -f /sys/fs/cgroup/cgroup.controllers ]; then
      mkdir -p /sys/fs/cgroup/init
      xargs -rn1 </sys/fs/cgroup/cgroup.procs >/sys/fs/cgroup/init/cgroup.procs 2>/dev/null || :
      sed -e 's/ / +/g' -e 's/^/+/' </sys/fs/cgroup/cgroup.controllers \
        >/sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || :
    fi
    nohup dockerd >>"$log" 2>&1 </dev/null 9>&- &
  fi
fi

i=0
until docker info >/dev/null 2>&1; do
  i=$((i + 1))
  if [ "$i" -gt "$timeout" ]; then
    echo "start-docker: engine not ready after ${timeout}s; tail of $log:" >&2
    tail -n 30 "$log" >&2 || :
    exit 1
  fi
  sleep 1
done
